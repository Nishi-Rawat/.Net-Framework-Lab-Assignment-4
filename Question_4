using System;

class Program
{
    // Custom delegate that returns an integer
    delegate int Calculator(int a, int b);

    // Addition
    static int Addition(int a, int b)
    {
        return a + b;
    }

    // Subtraction
    static int Subtraction(int a, int b)
    {
        return a - b;
    }

    // Multiplication
    static int Multiplication(int a, int b)
    {
        return a * b;
    }

    // Division
    static int Division(int a, int b)
    {
        return a / b;
    }

    static void Main()
    {
        // Create multicast delegate
        Calculator calc = Addition;

        // Attach other methods
        calc += Subtraction;
        calc += Multiplication;
        calc += Division;

        // Get all methods attached to the delegate
        Delegate[] methods = calc.GetInvocationList();

        // Execute each method separately
        foreach (Calculator method in methods)
        {
            int result = method(20, 5);
            Console.WriteLine("Result = " + result);
        }
    }
}
